# ============================================================
# Verde & Azul Gestao — Variaveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# URL de conexao do Supabase (PostgreSQL)
# Encontre em: Supabase Dashboard -> Settings -> Database -> Connection String -> URI
DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[SEU-PROJETO].supabase.co:5432/postgres

# JWT Secret (use uma string longa e aleatoria - nunca compartilhe)
JWT_SECRET=troque-por-uma-string-aleatoria-longa-aqui

# Ambiente
NODE_ENV=production

# Porta (Vercel define automaticamente, necessario apenas para uso local)
PORT=3000

# Secret para proteger o endpoint de cron (opcional mas recomendado)
CRON_SECRET=outro-segredo-aqui
